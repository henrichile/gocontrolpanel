# Copia este archivo a .env y ajusta los valores antes de `make up`.

# --- Panel -----------------------------------------------------------------
GOCP_ENV=production
GOCP_PUBLIC_URL=https://panel.tudominio.cl
GOCP_LISTEN_ADDR=:8080

# Genera uno nuevo con: openssl rand -hex 32
GOCP_JWT_SECRET=

# Primer administrador (solo se usa si no hay usuarios en la base de datos).
GOCP_ADMIN_USER=admin
GOCP_ADMIN_EMAIL=admin@tudominio.cl
GOCP_ADMIN_PASSWORD=

# --- Bases de datos --------------------------------------------------------
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- SFTP (acceso a archivos de cada cuenta) --------------------------------
# Credenciales del ADMIN de la API de sftpgo (no de los usuarios SFTP de cada
# cuenta, que el panel crea dinámicamente). Genera una clave con:
# openssl rand -base64 32
GOCP_SFTP_ADMIN_USER=gocp-admin
GOCP_SFTP_ADMIN_PASSWORD=
# Host/puerto que el cliente usa para conectarse (normalmente el mismo
# dominio del panel, puerto 2022).
GOCP_SFTP_PUBLIC_HOST=panel.tudominio.cl
GOCP_SFTP_PUBLIC_PORT=2022

# --- Caddy / TLS -----------------------------------------------------------
# Correo de contacto para Let's Encrypt (obligatorio en producción).
GOCP_CADDY_EMAIL=admin@tudominio.cl

# --- Docker ----------------------------------------------------------------
GOCP_DOCKER_NETWORK=gocontrolpanel_sites
GOCP_SITE_IMAGE_PREFIX=gocp/frankenphp
GOCP_SITES_ROOT=/srv/gocp/accounts

# --- Opcionales ------------------------------------------------------------
GOCP_ACCESS_TTL=15m
GOCP_REFRESH_TTL=720h
GOCP_METRICS_INTERVAL=60s
GOCP_BCRYPT_COST=12
