# Copia este archivo a .env y ajusta los valores antes de `make up`.

# --- Panel -----------------------------------------------------------------
GOCP_ENV=production
GOCP_PUBLIC_URL=https://panel.tudominio.cl
GOCP_LISTEN_ADDR=:8080

# Genera uno nuevo con: openssl rand -hex 32
GOCP_JWT_SECRET=

# Primer administrador (solo se usa si no hay usuarios en la base de datos).
GOCP_ADMIN_USER=admin
GOCP_ADMIN_EMAIL=admin@tudominio.cl
GOCP_ADMIN_PASSWORD=

# --- Bases de datos --------------------------------------------------------
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Caddy / TLS -----------------------------------------------------------
# Correo de contacto para Let's Encrypt (obligatorio en producción).
GOCP_CADDY_EMAIL=admin@tudominio.cl

# --- Docker ----------------------------------------------------------------
GOCP_DOCKER_NETWORK=gocontrolpanel_sites
GOCP_SITE_IMAGE_PREFIX=gocp/frankenphp
GOCP_SITES_ROOT=/srv/gocp/accounts

# --- Opcionales ------------------------------------------------------------
GOCP_ACCESS_TTL=15m
GOCP_REFRESH_TTL=720h
GOCP_METRICS_INTERVAL=60s
GOCP_BCRYPT_COST=12
